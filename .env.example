# Copy this file to .env. Keep .env private; it is ignored by Git.
# Local disposable PostgreSQL remains the default for development and tests.
DATABASE_TARGET=local

# Supabase PostgreSQL connection (used by the backend only).
# In Supabase: Project > Connect > Session pooler. Use the restricted school_app
# role (pooler username format: school_app.<PROJECT_REF>), never postgres.
# Download the project CA certificate from Database Settings > SSL and use its
# absolute local path below. URL-encode reserved characters in the password.
# Set DATABASE_TARGET=supabase when these values are ready.
DATABASE_URL=postgresql://school_app.<PROJECT_REF>:<URL_ENCODED_PASSWORD>@<SESSION_POOLER_HOST>:5432/postgres?sslmode=verify-full&sslrootcert=/absolute/path/to/supabase-root.crt

# Optional background worker connection. Configure a separate school_worker
# password in Supabase and keep this credential private; do not reuse school_app.
WORKER_DATABASE_URL=postgresql://school_worker.<PROJECT_REF>:<URL_ENCODED_WORKER_PASSWORD>@<SESSION_POOLER_HOST>:5432/postgres?sslmode=verify-full&sslrootcert=/absolute/path/to/supabase-root.crt

# Temporary one-time migration credential; never use this for the running app.
# Use the postgres.<PROJECT_REF> session-pooler username and remove this entry
# from your local .env after migrations are applied. Keep it unset for dry runs.
DATABASE_MIGRATION_URL=postgresql://postgres.<PROJECT_REF>:<URL_ENCODED_ADMIN_PASSWORD>@<SESSION_POOLER_HOST>:5432/postgres?sslmode=verify-full&sslrootcert=/absolute/path/to/supabase-root.crt

# Server (defaults keep local development on 127.0.0.1:3018, localhost hosts only).
# PORT=3018
# HOST=127.0.0.1
# ALLOWED_HOSTS=app.example.com          # comma-separated Host names accepted besides localhost
# ALLOWED_ORIGINS=https://app.example.com  # comma-separated https origins allowed to send writes
# TRUST_PROXY=1                          # number of trusted proxy hops in front of the API; 0 if none
